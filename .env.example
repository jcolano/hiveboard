# HiveBoard Configuration (environment variable overrides)
# These override values in config.json. Prefix: HIVEBOARD_

HIVEBOARD_DEV_KEY=hb_live_CHANGE_ME_00000000000000000000
HIVEBOARD_DEV_PASSWORD=change-me
HIVEBOARD_JWT_SECRET=change-me-in-production

# Mode: "local" for direct WebSocket, "production" for AWS API Gateway bridge
HIVEBOARD_MODE=local

# AWS WebSocket bridge (only needed in production mode)
# HIVEBOARD_WS_GATEWAY_ENDPOINT=https://your-api-id.execute-api.us-east-1.amazonaws.com/production
# HIVEBOARD_WS_GATEWAY_REGION=us-east-1
